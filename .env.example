# Infrastructure
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

# Service Configuration
DATABASE_URL=postgres://tracker:tracker@postgres:5432/tracker?sslmode=disable
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092
ENV=development
PORT=8080
GRPC_PORT=9090

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin

# Security — override these in any non-dev deployment.
# Dev default is hardcoded in docker-compose.yml so the stack works out-of-the-box;
# generate a real secret for staging/prod, e.g.:  openssl rand -base64 48
JWT_SECRET=dev-secret-change-in-production
